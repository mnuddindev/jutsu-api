# Application Configuration
APP_NAME=Jutsu API
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=15
SERVER_IDLE_TIMEOUT=120
SERVER_PREFORK=false

# Redis Configuration
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=10120
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5
REDIS_READ_TIMEOUT=3
REDIS_WRITE_TIMEOUT=3
REDIS_POOL_TIMEOUT=4
REDIS_IDLE_TIMEOUT=5
REDIS_IDLE_CHECK_FREQ=1

# Logger Configuration
LOG_LEVEL=info
LOG_ENCODING=json
LOG_OUTPUT_PATH=stdout
LOG_ERROR_PATH=stderr

# CORS Configuration
# Comma-separated list of allowed origins (e.g., https://site1.com,https://site2.com)
# Use * for all origins (credentials will be automatically disabled)
ALLOWED_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=false
CORS_EXPOSE_HEADERS=Content-Length
CORS_MAX_AGE=3600

RATE_LIMIT_ENABLED=true

# Cache TTL Configuration (in seconds)
# Static data (never or rarely changes)
CACHE_TTL_CHARACTER=86400      # 24 hours
CACHE_TTL_ACTOR=86400          # 24 hours
CACHE_TTL_STUDIO=86400         # 24 hours
CACHE_TTL_PRODUCER=86400       # 24 hours

# Semi-static data (changes daily/weekly)
CACHE_TTL_ANIME_INFO=21600     # 6 hours
CACHE_TTL_EPISODES=3600        # 1 hour
CACHE_TTL_QTIP=21600           # 6 hours

# Dynamic data (changes frequently)
CACHE_TTL_HOME=900             # 15 minutes
CACHE_TTL_TOP_TEN=3600         # 1 hour
CACHE_TTL_TOP_SEARCH=3600      # 1 hour
CACHE_TTL_TOP_AIRING=7200      # 2 hours
CACHE_TTL_GENRE=14400          # 4 hours

# Time-sensitive data
CACHE_TTL_SCHEDULE=600         # 10 minutes
CACHE_TTL_NEXT_EPISODE=1800    # 30 minutes
CACHE_TTL_SERVERS=300          # 5 minutes

# User-specific or frequently changing (short or no cache)
CACHE_TTL_SEARCH=300           # 5 minutes
CACHE_TTL_SUGGEST=180          # 3 minutes
CACHE_TTL_RANDOM=60            # 1 minute
CACHE_TTL_STREAM=0             # Don't cache (or 180 = 3 min max)