#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
tmp

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Build artifacts
bin/
*.exe
*.dll
*.so
*.dylib

# Test coverage
coverage.html
coverage.out

# Logs
*.log
logs/

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker volumes
postgres_data/
redis_data/
SETUP.md